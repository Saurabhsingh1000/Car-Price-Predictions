# Copy this file to .env and adjust as needed.
# The application currently has no required secrets, but these are provided
# for local overrides and future extension (e.g. a different host/port).

# Host/port the API binds to when run via `make run` or `docker-compose up`
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
